{
  "name": "streaming-markdown-bench",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "1.64.1",
    "@smb/bench": "workspace:*",
    "@smb/ui": "workspace:*",
    "@swc/core": "1.16.18",
    "@types/bun": "^1.4.4",
    "dependency-cruiser": "18.7.0",
    "lefthook": "2.2.2",
    "steiger": "0.8.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "prepare": "lefthook install",
    "test:browser": "bunx playwright test",
    "check": "biome ci . && tsc -b && bun test && bun run lint:arch",
    "format": "biome check --write .",
    "lint:arch": "steiger ./apps/site/src && depcruise packages apps --config .dependency-cruiser.cjs"
  }
}
