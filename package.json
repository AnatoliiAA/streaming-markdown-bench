{
  "name": "streaming-markdown-bench",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "1.64.1",
    "@smb/bench": "workspace:*",
    "@smb/ui": "workspace:*",
    "@swc/core": "1.16.18",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "^1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "dependency-cruiser": "18.7.0",
    "lefthook": "2.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "steiger": "0.8.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "prepare": "lefthook install",
    "test:browser": "bunx playwright test",
    "test": "bun test --path-ignore-patterns='tests/tooling/**' --pass-with-no-tests",
    "test:tooling": "bun test ./tests/tooling",
    "check": "biome ci . && tsc -b && bun run test && bun run lint:arch",
    "check:all": "bun run check && bun run test:tooling",
    "format": "biome check --write .",
    "lint:arch": "steiger ./apps/site/src && depcruise packages apps --config .dependency-cruiser.cjs"
  }
}
